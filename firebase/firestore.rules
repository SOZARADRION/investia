rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsVerifiedAccount(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    function validProfile() {
      return request.resource.data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow get: if ownsVerifiedAccount(uid);
      allow list: if false;

      allow create: if ownsVerifiedAccount(uid)
        && validProfile()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if ownsVerifiedAccount(uid)
        && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      // Exclusão de perfil/conta será tratada em uma entrega específica.
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
